#include <iostream>
#include <vector>
using namespace std;

double mse(vector<double> x, vector<double> y)
{
    double sum = 0;
    int n = x.size();
    for(int i=0;i<n;i++)
    {
        double diff = x[i] - y[i];
        sum += diff * diff;
    }
    return sum / n;
}

int main()
{
    int n;
    cin >> n;
    vector<double> x(n), y(n);
    for(int i=0;i<n;i++)
        cin >> x[i];
    for(int i=0;i<n;i++)
        cin >> y[i];
    cout << mse(x,y);
    return 0;
}
